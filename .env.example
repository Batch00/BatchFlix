# Supabase -- shared Batch Apps project (supabase.com dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# TMDB API -- themoviedb.org > Settings > API > API Read Access Token
TMDB_BEARER_TOKEN=your-tmdb-bearer-token

# App URL -- http://localhost:3000 locally, https://batchflix.batch-apps.com in production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared secret for the scheduled season_stats refresh (generate with: openssl rand -hex 32)
# Vercel sends it as "Authorization: Bearer $CRON_SECRET" on scheduled invocations
CRON_SECRET=your-random-secret
