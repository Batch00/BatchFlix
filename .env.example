# Supabase -- shared Batch Apps project (supabase.com dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# TMDB API -- themoviedb.org > Settings > API > API Read Access Token
TMDB_BEARER_TOKEN=your-tmdb-bearer-token

# Resend -- resend.com dashboard
RESEND_API_KEY=re_your-resend-api-key

# App URL -- http://localhost:3000 locally, https://batchflix.batch-apps.com in production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin email -- where access request notifications are sent
BATCHFLIX_ADMIN_EMAIL=you@example.com

# Secret used to sign approval/deny tokens (generate with: openssl rand -hex 32)
APPROVAL_SECRET=your-random-secret
